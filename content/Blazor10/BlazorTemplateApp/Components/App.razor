<!DOCTYPE html>
<html lang="en" data-bs-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["BlazorTemplateApp.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <!-- Bloqueante de propósito: aplica o tema antes do primeiro paint. -->
    <script src="@Assets["js/theme.js"]"></script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // A navegação aprimorada sincroniza o DOM com o HTML vindo do servidor,
        // o que reverteria o data-bs-theme do <html>. Reaplica a cada navegação.
        Blazor.addEventListener('enhancedload', function () { window.appTheme.apply(); });
    </script>
</body>

</html>
