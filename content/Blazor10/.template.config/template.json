{
  "$schema": "http://json.schemastore.org/template",
  "author": "Gentil Pedro",
  "classifications": [ "Web", "Blazor", "C#" ],
  "identity": "GentilPedro.Templates.Blazor10",
  "name": "Gentil Pedro - Blazor Web App (.NET 10)",
  "shortName": "blazor10",
  "sourceName": "BlazorTemplateApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "symbols": {
    "InteractivityMode": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "Auto",
      "choices": [
        { "choice": "Server", "description": "Interatividade via Blazor Server" },
        { "choice": "WebAssembly", "description": "Interatividade via Blazor WebAssembly" },
        { "choice": "Auto", "description": "Server no primeiro acesso, depois WebAssembly" }
      ],
      "description": "Modo de interatividade do Blazor (informativo — o template já vem configurado como Auto)."
    }
  }
}
